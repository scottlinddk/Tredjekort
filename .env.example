# Server-side credentials for address search and address reports (DAR).
# Copy to .env.local for `npm run dev`; set the same variables in the Vercel project.
# Never prefix these with VITE_: that would ship them to the browser.

# Dataforsyningen GSearch token (typeahead and typed-address search)
DATAFORSYNINGEN_TOKEN=

# Datafordeler API key (DAR GraphQL record lookup)
DATAFORDELER_API_KEY=

# Optional: override the DAR GraphQL endpoint. Default: https://graphql.datafordeler.dk/DAR/v1
# DAR_GRAPHQL_URL=
