# Server-side credentials for address search and address reports (DAR).
# Copy to .env.local for `npm run dev`; set the same variables in the Vercel project.
# Never prefix these with VITE_: that would ship them to the browser.

# Adressevælger token from Klimadatastyrelsen (search, typed addresses and id lookup)
ADRESSEVAELGER_TOKEN=

# Optional. Public address of a Hørbar deployment (https://github.com/scottlinddk/mash).
# When set, the traffic sensitivity table links to it so the difference can be heard.
# This is a public URL, not a credential, so the VITE_ prefix is intended here.
VITE_HOERBAR_URL=
